{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/knowledgebase/layout,_N_T_/knowledgebase/page,_N_T_/knowledgebase"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/knowledgebase/__PAGE__",
    "/knowledgebase",
    "/_index",
    "/_head"
  ]
}