{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/suspend/layout,_N_T_/suspend/page,_N_T_/suspend"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/suspend/__PAGE__",
    "/suspend",
    "/_index",
    "/_head"
  ]
}